venv/
.venv/
env/
node_modules/
__pycache__/
*.pyc
.ipynb_checkpoints/

# --- 日志与本地回收 ---
*.log
logs/
.trash/

# --- 运行数据/结果（本项目一般不产生，预留） ---
data/
results/

